<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fess-ds-microsoft365</artifactId>
	<packaging>jar</packaging>
	<name>Microsoft365 Data Store</name>
	<version>15.9.0-SNAPSHOT</version>
	<scm>
		<connection>scm:git:git@github.com:codelibs/fess-ds-microsoft365.git</connection>
		<developerConnection>scm:git:git@github.com:codelibs/fess-ds-microsoft365.git</developerConnection>
		<url>https://github.com/codelibs/fess-ds-microsoft365</url>
	  <tag>HEAD</tag>
  </scm>
	<parent>
		<groupId>org.codelibs.fess</groupId>
		<artifactId>fess-parent</artifactId>
		<version>15.9.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- The JUnit 5 migration silently collected zero tests for seven
					     months because @Test was never added. Fail the build instead. -->
					<failIfNoTests>true</failIfNoTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<artifactSet>
								<includes>
									<include>com.azure:azure-core</include>
									<include>com.azure:azure-core-http-netty</include>
									<include>com.azure:azure-identity</include>
									<include>com.azure:azure-json</include>
									<include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</include>
									<include>com.fasterxml.jackson.dataformat:jackson-dataformat-xml</include>
									<include>com.microsoft.azure:msal4j</include>
									<include>com.microsoft.graph:microsoft-graph</include>
									<include>com.microsoft.graph:microsoft-graph-core</include>
									<include>com.microsoft.kiota:microsoft-kiota-abstractions</include>
									<include>com.microsoft.kiota:microsoft-kiota-authentication-azure</include>
									<include>com.microsoft.kiota:microsoft-kiota-http-okHttp</include>
									<include>com.squareup.okhttp3:okhttp-jvm</include>
									<include>com.squareup.okio:okio-jvm</include>
									<include>org.jetbrains.kotlin:kotlin-stdlib</include>
									<include>com.microsoft.kiota:microsoft-kiota-serialization-json</include>
									<include>com.microsoft.kiota:microsoft-kiota-serialization-text</include>
									<include>com.microsoft.kiota:microsoft-kiota-serialization-form</include>
									<include>com.microsoft.kiota:microsoft-kiota-serialization-multipart</include>
									<include>io.github.std-uritemplate:std-uritemplate</include>
									<include>io.projectreactor.netty:reactor-netty</include>
									<include>io.projectreactor.netty:reactor-netty-http</include>
									<include>io.projectreactor.netty:reactor-netty-core</include>
									<include>io.projectreactor:reactor-core</include>
									<include>io.opentelemetry:opentelemetry-api</include>
									<include>io.opentelemetry:opentelemetry-context</include>
									<include>io.opentelemetry:opentelemetry-common</include>
									<include>io.netty:netty-buffer</include>
									<include>io.netty:netty-codec</include>
									<include>io.netty:netty-codec-dns</include>
									<include>io.netty:netty-codec-http</include>
									<include>io.netty:netty-codec-http2</include>
									<include>io.netty:netty-common</include>
									<include>io.netty:netty-handler</include>
									<include>io.netty:netty-handler-proxy</include>
									<include>io.netty:netty-resolver</include>
									<include>io.netty:netty-resolver-dns</include>
									<include>io.netty:netty-transport</include>
									<include>io.netty:netty-transport-native-unix-common</include>
									<include>org.reactivestreams:reactive-streams</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<!-- kotlin-stdlib and okio are modular; a module descriptor from one
										     of them at the root of this jar would describe the wrong module. -->
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<relocations>
								<relocation>
									<pattern>io.netty</pattern>
									<shadedPattern>org.codelibs.fess.ds.ms365.netty</shadedPattern>
								</relocation>
							</relocations>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<!-- Fess plugins are distributed through maven.codelibs.org instead of Maven Central.
	     This cannot be inherited from fess-parent: distributionManagement is inherited
	     unconditionally, so declaring it there would also redirect the SNAPSHOT
	     deployments of fess-parent, fess, fess-crawler, fess-crawler-playwright and
	     fess-suggest, which stay on Maven Central. The scpexe transport comes from
	     the wagon-ssh-external build extension inherited from fess-parent. -->
	<distributionManagement>
		<repository>
			<id>codelibs-repo</id>
			<name>CodeLibs Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/release</url>
		</repository>
		<snapshotRepository>
			<id>codelibs-snapshots</id>
			<name>CodeLibs Snapshot Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/snapshot</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<repository>
			<id>snapshots.central.sonatype.com</id>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta.annotation.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.servlet.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.codelibs</groupId>
			<artifactId>corelib</artifactId>
			<version>${corelib.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>${guava.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>animal-sniffer-annotations</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.j2objc</groupId>
					<artifactId>j2objc-annotations</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.checkerframework</groupId>
					<artifactId>checker-compat-qual</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.code.findbugs</groupId>
					<artifactId>jsr305</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.errorprone</groupId>
					<artifactId>error_prone_annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
			<version>${jackson2.version}</version>
		</dependency>
		<dependency>
			<groupId>org.lastaflute</groupId>
			<artifactId>lastaflute</artifactId>
			<version>${lastaflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.dbflute</groupId>
			<artifactId>dbflute-runtime</artifactId>
			<version>${dbflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess</artifactId>
			<version>${fess.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.opensearch</groupId>
			<artifactId>opensearch</artifactId>
			<version>${opensearch.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- azure-core needs org.reactivestreams.Publisher as soon as it creates a ClientLogger,
			     which every azure-identity credential builder does in its static initializer. The
			     shade already includes reactive-streams, but it takes compile and runtime artifacts
			     only, and without this declaration Maven resolves reactive-streams under the provided
			     opensearch node above (reactor-core itself is resolved there), so it was never shaded.
			     Fess carried it in WEB-INF/lib next to the opensearch jar until 15.9. 1.0.4 is the
			     version reactor-core declares. -->
			<groupId>org.reactivestreams</groupId>
			<artifactId>reactive-streams</artifactId>
			<version>1.0.4</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.dbflute.utflute</groupId>
			<artifactId>utflute-lastaflute</artifactId>
			<version>${utflute.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.microsoft.graph</groupId>
			<artifactId>microsoft-graph</artifactId>
			<version>${microsoft.graph.version}</version>
			<exclusions>
				<!-- Kiota asks for okhttp 4.12.0. This plugin runs on okhttp-jvm 5.x, declared
				     below and shaded into the plugin jar; the two cannot both be on the class
				     path, and MockWebServer fails with NoSuchMethodError on
				     okhttp3.internal.concurrent.TaskRunner when they are. -->
				<exclusion>
					<groupId>com.squareup.okhttp3</groupId>
					<artifactId>okhttp</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.azure</groupId>
			<artifactId>azure-identity</artifactId>
			<version>${azure.identity.version}</version>
		</dependency>
		<dependency>
			<groupId>com.azure</groupId>
			<artifactId>azure-core</artifactId>
			<version>${azure.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.azure</groupId>
			<artifactId>azure-core-http-netty</artifactId>
			<version>${azure.core.http.netty.version}</version>
		</dependency>
		<dependency>
			<!-- Microsoft365Client builds the Graph client from an OkHttpClient.Builder that
			     GraphClientFactory hands back, so okhttp is part of this plugin's API surface,
			     not an implementation detail it could hide. Fess carried it in WEB-INF/lib for
			     this plugin's sake until 15.9; it travels in the plugin jar now, so an
			     installation that does not crawl Microsoft 365 does not pay for it. -->
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp-jvm</artifactId>
			<version>${okhttp.version}</version>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>mockwebserver</artifactId>
			<version>${okhttp.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>5.17.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
